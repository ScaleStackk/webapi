# Container and HTTP
DOCKER_PLATFORM=linux/amd64
DOCKER_NETWORK=questacase
WEBAPI_IMAGE=questacase-webapi:latest
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
API_BASE_PATH=api/v1
API_ALLOWED_ORIGINS=https://questacase.web.app,https://questacase.firebaseapp.com,http://localhost:3000
WEBAPI_MEMORY_LIMIT=512m
WEBAPI_CPU_LIMIT=1.0

# AWS S3. On EC2, use an IAM instance role instead of access keys.
AWS_REGION=ap-south-1
S3_BUCKET=replace-with-private-judgment-bucket
S3_PREFIX=judgments
S3_PRESIGN_SECONDS=300
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
MAX_PDF_BYTES=52428800

# Kafka. kafka:19092 works when the broker shares the questacase Docker network.
KAFKA_BROKERS=kafka:19092
KAFKA_CLIENT_ID=questacase-webapi
KAFKA_UPLOAD_TOPIC=judgment.uploaded
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Query embedding service. It must use the same model as indexed judgment chunks.
EMBEDDING_API_URL=http://embedding-api:8081/embed
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-qdrant-admin-or-read-key
QDRANT_COLLECTION=judgment_chunks
QDRANT_RESULT_LIMIT=8

# Neo4j. Set NEO4J_REQUIRED=true to fail queries instead of vector-only fallback.
NEO4J_URL=http://neo4j:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_RESULT_LIMIT=30
NEO4J_REQUIRED=false

# Ollama or the HAProxy inference endpoint
INFERENCE_API_URL=http://inference:11434
INFERENCE_MODEL=qwen3:4b
INFERENCE_API_KEY=
INFERENCE_NUM_PREDICT=600
MAX_CONTEXT_CHARACTERS=24000
REQUEST_TIMEOUT_MS=15000
